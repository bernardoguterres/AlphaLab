# AlphaLab Environment Variables
#
# IMPORTANT: unlike AlphaLive/AlphaSignal, this app does NOT auto-load .env
# (python-dotenv is a listed dependency but load_dotenv() is never called
# anywhere in this codebase). Copying this to .env alone does nothing - export
# these into your shell first, e.g. `export $(grep -v '^#' .env | xargs)`
# before `python run.py`, or set them directly in Railway's dashboard.
#
# Note: AlphaLab does NOT integrate with AlphaSignal - its fundamental
# screener calls yfinance directly. Only AlphaLive's sentiment gate does.

# ── API Server (overrides config.yaml when set - see config.py) ─────────────
PORT=5050
HOST=127.0.0.1
DEBUG=false                    # true enables Flask's debugger - never in production
ALLOWED_ORIGINS=                # comma-separated extra CORS origins beyond config.yaml's defaults

# ── Settings page "test connection" endpoints (optional) ────────────────────
# Only needed to use Settings > Test Telegram/Alpaca in the UI. Never stored
# in app_settings.json - env vars only, per this repo's security rules.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
